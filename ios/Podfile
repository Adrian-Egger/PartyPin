platform :ios, '14.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'
project 'Runner', { 'Debug' => :debug, 'Profile' => :release, 'Release' => :release }

def flutter_root
  p = File.expand_path(File.join('..','Flutter','Generated.xcconfig'), __FILE__)
  raise "#{p} must exist. Run 'flutter pub get' first." unless File.exist?(p)
  File.foreach(p) { |line| m = line.match(/FLUTTER_ROOT\=(.*)/); return m[1].strip if m }
  raise "FLUTTER_ROOT not found."
end

require File.expand_path(File.join('packages','flutter_tools','bin','podhelper'), flutter_root)
flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |t|
    flutter_additional_ios_build_settings(t)
    t.build_configurations.each do |cfg|
      cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
    end
  end

  # Add Flutter.xcframework to project-level FRAMEWORK_SEARCH_PATHS so SPM plugins
  # (url_launcher_ios, shared_preferences_foundation, etc.) can `import Flutter`
  # before xcode_backend.sh builds the framework in the Run Script phase.
  artifacts_dir = File.join(flutter_root, 'bin', 'cache', 'artifacts', 'engine')
  runner_project = installer.aggregate_targets
    .find { |t| t.name == 'Pods-Runner' }
    &.user_project
  if runner_project
    runner_project.build_configurations.each do |config|
      engine_dir = (config.name == 'Debug') ?
        File.join(artifacts_dir, 'ios', 'Flutter.xcframework') :
        File.join(artifacts_dir, 'ios-release', 'Flutter.xcframework')
      next unless Dir.exist?(engine_dir)
      slices = Dir.entries(engine_dir).reject { |e| e.start_with?('.') }
      iphoneos  = slices.find { |s| s.start_with?('ios-arm64') && !s.include?('simulator') }
      simulator = slices.find { |s| s.include?('simulator') }
      config.build_settings['FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*]'] =
        "\"#{File.join(engine_dir, iphoneos)}\" $(inherited)" if iphoneos
      config.build_settings['FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*]'] =
        "\"#{File.join(engine_dir, simulator)}\" $(inherited)" if simulator
    end
    runner_project.save
  end

  %w[openssl_grpc BoringSSL-GRPC].each do |name|
    t = installer.pods_project.targets.find { |x| x.name == name }
    next unless t
    t.build_configurations.each do |c|
      s = c.build_settings
      s['CODE_SIGNING_ALLOWED']  = 'NO'
      s['CODE_SIGNING_REQUIRED'] = 'NO'
      s['CODE_SIGNING_IDENTITY'] = ''
      s['CODE_SIGN_STYLE']       = 'Manual'
      s['SKIP_INSTALL']          = 'YES'
    end
  end
end
